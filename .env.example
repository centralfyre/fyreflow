# Credenciais da API do Trello
# Obtenha em https://trello.com/app-key
TRELLO_KEY=
TRELLO_TOKEN=

# IDs (ou "short names" da URL) das Workspaces do Trello a serem varridas
# por completo — a plataforma busca automaticamente TODOS os boards abertos
# dessas Workspaces, então novos boards de clientes entram sozinhos.
# Separe múltiplas Workspaces por vírgula.
# O nome aparece na URL: trello.com/w/<NOME>/...
TRELLO_WORKSPACE_IDS=

# Opcional: IDs de boards específicos a incluir além (ou no lugar) das
# Workspaces acima. Separe múltiplos por vírgula.
# O ID do board aparece na URL: trello.com/b/<ID>/nome-do-board
TRELLO_BOARD_IDS=

# Opcional: palavras-chave (em minúsculas, separadas por vírgula) usadas para
# identificar quais listas do Trello representam "entregue"/"concluído".
# Padrão: concluído,concluido,done,feito,entregue,finalizado,pronto
DONE_LIST_KEYWORDS=

# Opcional: quantos dias de histórico de entregas exibir por pessoa.
# Padrão: 60
HISTORY_LOOKBACK_DAYS=

# Porta do servidor (opcional, padrão 3000)
PORT=3000
